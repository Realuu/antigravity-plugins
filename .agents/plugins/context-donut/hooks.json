{
  "context-donut-tracker": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./scripts/hook-tracker.mjs session_start",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/hook-tracker.mjs pre_invocation",
        "timeout": 5
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/hook-tracker.mjs post_invocation",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./scripts/hook-tracker.mjs stop",
        "timeout": 5
      }
    ]
  }
}
